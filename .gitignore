# Mom's recipes. The repo is public, so her data must never be committed.
# import.sql is made by dev/make-import.py; the other two are left over from
# the old Google Sheet test setup and can be deleted.
dev/*.sql
# ...except the guest-rules check, which holds no data of hers.
!dev/guest-rls-test.sql
dev/fixture.json
dev/test-sheet.json
*.xlsx

# Made by the Vercel command-line tool, if it's ever used.
.vercel
.env*

.DS_Store

# Ingredient lists for her recipes (her data): reviewed locally, never committed.
dev/ingredients*
# Which of her recipes are Naadan / One pot (dev/server.js --mine reads it): her data too.
dev/tags.txt

# Temporary files from the Supabase command-line tool.
supabase/.temp/

# Screenshots of the app made while testing, to show around; not part of the app.
dev/preview-*.png
dev/photos/

# Database backups made before a migration (dev/GUEST-ROLLOUT.md): her data.
dev/backup/
dev/concepts/
dev/redesign-wip/
dev/live/

# New recipe ideas picked for her, checked against her list (her data).
dev/new-recipes.json
dev/new-recipes.md
